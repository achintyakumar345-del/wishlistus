{% if product %}
<div class="wl-wrap" style="--wl-color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
  <button
    type="button"
    class="wl-btn"
    data-wl-handle="{{ product.handle }}"
    data-wl-add="{{ block.settings.add_label | escape }}"
    data-wl-remove="{{ block.settings.remove_label | escape }}"
    aria-pressed="false"
  >
    <svg class="wl-heart" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg>
    <span class="wl-label">{{ block.settings.add_label }}</span>
  </button>
</div>
<script type="application/json" data-wl-settings>{{ app.metafields.wishlistus.settings.value | json }}</script>
{% endif %}

{% schema %}
{
  "name": "Wishlist button",
  "target": "section",
  "javascript": "wishlist.js",
  "stylesheet": "wishlist.css",
  "settings": [
    { "type": "text", "id": "add_label", "label": "Button text", "default": "Add to wishlist" },
    { "type": "text", "id": "remove_label", "label": "Button text when saved", "default": "Saved to wishlist" },
    { "type": "color", "id": "color", "label": "Heart colour", "default": "#e0245e" }
  ]
}
{% endschema %}